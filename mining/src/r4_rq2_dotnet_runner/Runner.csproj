<Project Sdk="Microsoft.NET.Sdk">
  <!-- Runs the SDK's .NET analyzers on loose C# files (round-4 RQ2 real-code run; see src/r4_rq2_run_dotnet.py). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType><TargetFramework>net10.0</TargetFramework><Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings><EnableNETAnalyzers>false</EnableNETAnalyzers>
    <SdkDir>$(NetCoreRoot)sdk/$(NETCoreSdkVersion)/</SdkDir>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="Microsoft.CodeAnalysis"><HintPath>$(SdkDir)Roslyn/bincore/Microsoft.CodeAnalysis.dll</HintPath></Reference>
    <Reference Include="Microsoft.CodeAnalysis.CSharp"><HintPath>$(SdkDir)Roslyn/bincore/Microsoft.CodeAnalysis.CSharp.dll</HintPath></Reference>
  </ItemGroup>
</Project>
