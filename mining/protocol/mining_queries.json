{
  "frozen": "2026-10-01",
  "endpoint": "https://api.github.com/search/commits",
  "window": ["2010-01-01", "2026-09-30"],
  "rule": "If total_count<=1000 retrieve all pages of 100; otherwise slice committer-date by calendar quarter and retrieve page 1 (100 items, GitHub best-match order) per slice. Store total_count per slice.",
  "queries": [
    {"id":"J1","family":"java_pin","q":"\"Locale.ROOT\""},
    {"id":"J2","family":"java_pin","q":"\"Locale.ENGLISH\" case"},
    {"id":"J3","family":"java_pin","q":"\"toLowerCase(Locale\""},
    {"id":"J4","family":"java_pin","q":"\"toUpperCase(Locale\""},
    {"id":"J5","family":"java_pin","q":"\"Locale.US\" lowercase"},
    {"id":"N1","family":"dotnet_pin","q":"\"ToLowerInvariant\""},
    {"id":"N2","family":"dotnet_pin","q":"\"ToUpperInvariant\""},
    {"id":"N3","family":"dotnet_pin","q":"\"OrdinalIgnoreCase\""},
    {"id":"N4","family":"dotnet_pin","q":"\"StringComparison.Ordinal\""},
    {"id":"T1","family":"turkic_trigger","q":"\"Turkish locale\""},
    {"id":"T2","family":"turkic_trigger","q":"\"Turkish I\""},
    {"id":"T3","family":"turkic_trigger","q":"\"dotless i\""},
    {"id":"T4","family":"turkic_trigger","q":"turkish lowercase"},
    {"id":"T5","family":"turkic_trigger","q":"turkish uppercase"},
    {"id":"G1","family":"generic","q":"\"locale-insensitive\" case"},
    {"id":"G2","family":"generic","q":"\"locale independent\" lowercase"},
    {"id":"G3","family":"generic","q":"\"default locale\" lowercase"},
    {"id":"A1","family":"analyzer","q":"CA1304"},
    {"id":"A2","family":"analyzer","q":"CA1309"},
    {"id":"A3","family":"analyzer","q":"CA1311"},
    {"id":"A4","family":"analyzer","q":"StringCaseLocaleUsage"},
    {"id":"A5","family":"analyzer","q":"DM_CONVERT_CASE"},
    {"id":"C1","family":"native_pin","q":"g_ascii_strcasecmp"},
    {"id":"C2","family":"native_pin","q":"ascii_tolower"},
    {"id":"C3","family":"native_pin","q":"\"LC_ALL=C\" locale"},
    {"id":"S1","family":"other_ecosystem","q":"\"toLocaleLowerCase\""},
    {"id":"S2","family":"other_ecosystem","q":"to_ascii_lowercase"},
    {"id":"S3","family":"other_ecosystem","q":"casefold"},
    {"id":"D1","family":"collation","q":"collation glibc"},
    {"id":"D2","family":"collation","q":"\"collation version\""}
  ]
}
